// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use an environment variable for the database URL so we can switch providers easily.
  // For local development with Postgres set: DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  userId    String  @id
  name      String
  email     String  @unique
  password  String
  role      String  @default("user") // "admin" or "user"
  isBlocked Boolean @default(false)
}

model Products {
  productId         String              @id
  name              String
  price             Float
  rating            Float?
  stockQuantity     Int
  expiryDate        DateTime?
  // New descriptive fields for richer inventory details
  category          String?
  description       String?
  packSize          String?
  // Optional product barcode/EAN/UPC
  barcode           String?
  // Optional purchase price (cost) from supplier/import sheet
  purchasePrice     Float?
  Sales             Sales[]
  Purchases         Purchases[]
  CustomerPurchases CustomerPurchases[]
  InvoiceItems      InvoiceItems[]

  @@index([name])
  @@index([category])
  @@index([packSize])
  @@index([barcode])
}

model Sales {
  saleId      String   @id
  productId   String
  timestamp   DateTime
  quantity    Int
  unitPrice   Float
  totalAmount Float
  product     Products @relation(fields: [productId], references: [productId])
}

model Purchases {
  purchaseId String   @id
  productId  String
  timestamp  DateTime
  quantity   Int
  unitCost   Float
  totalCost  Float
  product    Products @relation(fields: [productId], references: [productId])
}

model Expenses {
  expenseId String   @id
  category  String
  amount    Float
  timestamp DateTime
}

model SalesSummary {
  salesSummaryId   String   @id
  totalValue       Float
  changePercentage Float?
  date             DateTime
}

model PurchaseSummary {
  purchaseSummaryId String   @id
  totalPurchased    Float
  changePercentage  Float?
  date              DateTime
}

model ExpenseSummary {
  expenseSummaryId  String              @id
  totalExpenses     Float
  date              DateTime
  ExpenseByCategory ExpenseByCategory[]
}

model ExpenseByCategory {
  expenseByCategoryId String         @id
  expenseSummaryId    String
  category            String
  amount              BigInt
  date                DateTime
  expenseSummary      ExpenseSummary @relation(fields: [expenseSummaryId], references: [expenseSummaryId])
}

// New models to track invoice deductions and customers
model Customers {
  customerId String              @id
  name       String
  mobile     String?
  address    String?
  city       String?
  state      String?
  country    String?
  createdAt  DateTime            @default(now())
  purchases  CustomerPurchases[]
  invoices   Invoices[]
  payments   Payments[]
}

model CustomerPurchases {
  id         String    @id
  customerId String
  productId  String
  timestamp  DateTime  @default(now())
  quantity   Int
  unitPrice  Float
  totalCost  Float
  customer   Customers @relation(fields: [customerId], references: [customerId])
  product    Products  @relation(fields: [productId], references: [productId])
}

// New invoice and payment models
enum InvoiceStatus {
  unpaid
  partial
  paid
}

enum PaymentTermType {
  immediate
  due_date
}

model Invoices {
  invoiceId         String          @id
  customerId        String
  date              DateTime        @default(now())
  location          String // open market, distribution, amagzy global, amagzy global ventures
  salesAgent        String
  // Optional references to normalized entities
  locationId        String?
  salesAgentId      String?
  vatPercent        Float           @default(7.5)
  discountPercent   Float           @default(0)
  paymentTermType   PaymentTermType @default(immediate)
  dueDate           DateTime?
  status            InvoiceStatus   @default(unpaid)
  totalWithoutVAT   Float           @default(0)
  vatAmount         Float           @default(0)
  totalWithVAT      Float           @default(0)
  notes             String?
  dueSoonNotifiedAt DateTime?

  customer Customers      @relation(fields: [customerId], references: [customerId])
  items    InvoiceItems[]
  payments Payments[]

  salesAgentRef SalesAgents? @relation(fields: [salesAgentId], references: [id])
  locationRef   Locations?   @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([date])
  @@index([status])
  @@index([salesAgentId])
  @@index([locationId])
}

model InvoiceItems {
  id        String  @id
  invoiceId String
  productId String?
  name      String
  unit      String // "ctn" or "pcs"
  quantity  Int
  unitPrice Float
  subtotal  Float

  invoice Invoices  @relation(fields: [invoiceId], references: [invoiceId])
  product Products? @relation(fields: [productId], references: [productId])
}

model Payments {
  id          String   @id
  invoiceId   String
  customerId  String
  date        DateTime @default(now())
  amount      Float
  bankName    String
  bankAccount String

  invoice  Invoices  @relation(fields: [invoiceId], references: [invoiceId])
  customer Customers @relation(fields: [customerId], references: [customerId])

  @@index([invoiceId])
  @@index([customerId])
}

// Normalized entities for sales agents and invoice locations
model SalesAgents {
  id        String    @id
  name      String
  mobile    String?
  email     String?
  createdAt DateTime  @default(now())
  invoices  Invoices[]

  @@index([name])
}

model Locations {
  id        String    @id
  name      String    @unique
  createdAt DateTime  @default(now())
  invoices  Invoices[]

  @@index([name])
}

// Store and Branch models for multi-store management
model Stores {
  id        String     @id
  name      String     @unique
  createdAt DateTime   @default(now())
  branches  Branches[]

  @@index([name])
}

model Branches {
  id        String   @id
  storeId   String
  name      String
  city      String?
  state     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  store     Stores   @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@unique([storeId, name])
}


// Tenant-aware replacements for JSON/meta stores
model FeatureFlags {
  userId    String   @id
  features  Json
  updatedAt DateTime @updatedAt
}

model InvoiceMeta {
  id            String   @id
  tenantId      String   @default("default")
  invoiceId     String   @unique
  invoiceNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PcsInventory {
  id        String   @id
  tenantId  String   @default("default")
  name      String
  quantity  Int      @default(0)
  productId String?
  packSize  String?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}
